{
  "name": "Pipeline 1 - Web Form Intake",
  "description": "Receives complaint from web form, extracts fields, runs AI intake agent, stores to Google Sheets, responds to webhook",
  "nodes": [
    {
      "name": "Complaint-Form-Trigger",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300],
      "parameters": {
        "path": "complaint-received",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "http://127.0.0.1:5500, https://dommmy200.github.io"
        }
      }
    },
    {
      "name": "Code - Extract and Validate",
      "type": "n8n-nodes-base.code",
      "position": [450, 300],
      "parameters": {
        "language": "javascript",
        "code": "// See scripts/extractor.js\n// Reads body.caseNumber, body.description\n// Runs regex extraction for structured fields\n// Handles isFollowUp bypass"
      }
    },
    {
      "name": "AI Agent - Intake and Followup",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [650, 300],
      "parameters": {
        "promptType": "define",
        "text": "// See scripts/preprocess.js for user prompt template",
        "options": {
          "systemMessage": "// 4-step system: Validate, Classify, Follow-up, Summary"
        }
      },
      "subNodes": {
        "chatModel": "Google Gemini (gemini-2.5-flash, temp: 0.3)",
        "memory": "Postgres Chat Memory (sessionKey: caseNumber)",
        "tool": "Google Sheets Tool (lookup existing complaints)"
      }
    },
    {
      "name": "Debugger Node",
      "type": "n8n-nodes-base.code",
      "position": [850, 300],
      "parameters": {
        "language": "javascript",
        "code": "// See scripts/debugger.js\n// Detects <case_data> block\n// Sets isComplete flag\n// Merges complaint data + AI output\n// Returns enriched JSON"
      }
    },
    {
      "name": "isComplete Switch",
      "type": "n8n-nodes-base.switch",
      "position": [1050, 300],
      "parameters": {
        "rules": [
          {
            "outputKey": "Complete",
            "condition": "{{ $json.isComplete }} === true"
          },
          {
            "outputKey": "Incomplete",
            "condition": "{{ $json.isComplete }} === false"
          }
        ]
      }
    },
    {
      "name": "Append to ComplaintsDB",
      "type": "n8n-nodes-base.googleSheets",
      "position": [1250, 200],
      "parameters": {
        "operation": "append",
        "sheetName": "ComplaintsDB",
        "columns": {
          "caseNumber": "={{ $json.caseNumber }}",
          "fullName": "={{ $json.fullName }}",
          "email": "={{ $json.email }}",
          "incidentDate": "={{ $json.incidentDate }}",
          "healthFacility": "={{ $json.facility }}",
          "complaintType": "={{ $json.complaintType }}",
          "priority_level": "={{ $json.caseData.confirmedSeverity }}",
          "investigative_summary": "={{ $json.caseData.summary }}",
          "submissionDate": "={{ $now.toFormat('yyyy-MM-dd') }}",
          "status": "pending_review"
        }
      }
    },
    {
      "name": "AI Agent Classification",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [1450, 200],
      "parameters": {
        "promptType": "define",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "// Institutional AI investigator\n// Classifies: MEDICAL_CARE, ADMINISTRATIVE_BILLING_INSURANCE\n// STAFF_MISCONDUCT, SECURITY_OR_CRIMINAL\n// INFRASTRUCTURE_SERVICE_QUALITY, OTHER\n// Priority: HIGH, MEDIUM, LOW"
        }
      },
      "subNodes": {
        "chatModel": "Google Gemini (temp: 0.3)",
        "outputParser": "Structured Output Parser (strict JSON schema)"
      }
    },
    {
      "name": "Reply User - Gmail",
      "type": "n8n-nodes-base.gmail",
      "position": [1650, 200],
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "Complaint Case {{ $json.caseNumber }} Received",
        "message": "// Confirmation email with case number and summary"
      }
    },
    {
      "name": "Success Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [1250, 400],
      "parameters": {
        "respondWith": "json",
        "responseBody": {
          "status": "complete",
          "caseNumber": "={{ $json.caseNumber }}",
          "message": "Your complaint has been submitted successfully."
        }
      }
    },
    {
      "name": "Failure Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [1250, 500],
      "parameters": {
        "respondWith": "json",
        "responseBody": {
          "status": "incomplete",
          "caseNumber": "={{ $json.caseNumber }}",
          "message": "Additional information is needed.",
          "aiQuestion": "={{ $json.aiQuestion }}"
        }
      }
    }
  ],
  "flow": "Webhook → Extract → AI Intake Agent → Debugger → Switch → [Complete: Append + Classify + Gmail + Success Respond] [Incomplete: Failure Respond]"
}